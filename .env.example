TEMPORAL_ADDRESS=your-namespace.your-account.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.your-account
TEMPORAL_API_KEY=replace-me
TEMPORAL_TASK_QUEUE=pi-gtm-demo

# Optional. Defaults to "${TEMPORAL_TASK_QUEUE}-codeact".
# Keeps the generated Python CodeAct worker from racing the TypeScript demo worker.
TEMPORAL_CODEACT_TASK_QUEUE=pi-gtm-demo-codeact

# Required for live Pi/LLM generation in the web UI and harness.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional. Defaults to "pi".
PI_COMMAND="pi --provider anthropic --model claude-sonnet-4-5"

# Optional. Defaults to 8787.
PORT=8787

# Optional. CodeAct scaffold generation wait before the demo-safe fallback keeps the run moving.
CODEACT_SCAFFOLD_TIMEOUT_MS=150000

# Optional. How many times malformed generated scaffold code is fed back to Pi for repair.
CODEACT_SCAFFOLD_REPAIR_ATTEMPTS=1

# Optional. Set to 0 for harness-only runs without Temporal Cloud.
CODEACT_TEMPORAL_CLOUD=1
