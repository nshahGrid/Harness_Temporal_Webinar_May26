TEMPORAL_ADDRESS=your-namespace.your-account.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.your-account
TEMPORAL_API_KEY=replace-me
TEMPORAL_TASK_QUEUE=pi-gtm-demo

# Optional. Defaults to "${TEMPORAL_TASK_QUEUE}-codeact-<run-id>".
# Keeps the generated Python CodeAct worker from racing the TypeScript demo worker.
# TEMPORAL_CODEACT_TASK_QUEUE=custom-codeact

# Required for live Pi/LLM generation in the web UI and harness.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional. Defaults to "pi".
PI_COMMAND="pi --provider anthropic --model claude-sonnet-4-5"

# Optional. Set to 0 to disable persistent Pi case-study extraction caching.
PI_EXTRACTION_CACHE=1

# Optional. Defaults to artifacts/cache/pi-case-study-extractions.json for harness extraction.
# Generated CodeAct Python workflows default to artifacts/cache/codeact-pi-extractions.json.
# PI_EXTRACTION_CACHE_PATH=artifacts/cache/pi-case-study-extractions.json
# CODEACT_PI_EXTRACTION_CACHE_PATH=artifacts/cache/codeact-pi-extractions.json

# Optional. Defaults to 8787.
PORT=8787

# Optional. CodeAct scaffold generation wait before the demo-safe fallback keeps the run moving.
CODEACT_SCAFFOLD_TIMEOUT_MS=150000

# Optional. How many times malformed generated scaffold code is fed back to Pi for repair.
# The harness enforces a minimum of 3 for the CodeAct cloud path.
CODEACT_SCAFFOLD_REPAIR_ATTEMPTS=3

# Optional. Set to 1 to run CodeAct scaffold validate/repair as a Temporal child workflow.
# Requires the TypeScript Temporal worker to be running on TEMPORAL_TASK_QUEUE.
CODEACT_SCAFFOLD_CHILD_WORKFLOW=0

# Optional. Set to 0 for harness-only runs without Temporal Cloud.
CODEACT_TEMPORAL_CLOUD=1
